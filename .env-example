# TrustFlix Digital V2 - Configuration .env (exemple)
# COPIER VERS .env ET REMPLACER LES VALEURS

# Database Configuration
DB_HOST=localhost
DB_NAME=trustflix_v2
DB_USER=root
DB_PASS=

# Application Settings
APP_ENV=production
APP_DEBUG=false
SESSION_TIMEOUT=3600

# Email Settings (pour futures notifications)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=your_email@example.com
MAIL_PASS=your_password

# WhatsApp Settings
WHATSAPP_PREFIX=225

# File Uploads
UPLOAD_MAX_SIZE=104857600
UPLOAD_ALLOWED_TYPES=pdf,xlsx,xls,csv,txt

# Log Settings
LOG_LEVEL=error
LOG_DATABASE=true
LOG_FILE=true
LOG_FILE_PATH=/logs/app.log

# Security
CSRF_TOKEN_EXPIRE=3600
REMEMBER_ME_DURATION=2592000

# Timezone
TIMEZONE=Africa/Abidjan

# Currency
CURRENCY=XOF
CURRENCY_SYMBOL=XOF
DECIMAL_SEPARATOR=,
THOUSANDS_SEPARATOR=

# API Settings (pour futures versions)
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=3600

# Features Toggle
FEATURE_PAYMENTS=true
FEATURE_REPORTS=false
FEATURE_EXPORTS=false
FEATURE_API=false
